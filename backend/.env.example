# SkillBridge Backend Environment Configuration

PROJECT_NAME=SkillBridge
API_V1_STR=/api/v1
SECRET_KEY=skillbridge_super_secret_jwt_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite for rapid dev & testing, or PostgreSQL)
DATABASE_URL=sqlite:///./skillbridge.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillbridge_db

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
